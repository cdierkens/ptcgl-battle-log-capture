{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTCGL Tracker",
  "version": "0.1.0",
  "identifier": "pro.pokedojo.capture",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PTCGL Tracker",
        "visible": false,
        "width": 420,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}